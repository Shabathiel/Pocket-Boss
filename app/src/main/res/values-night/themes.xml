        <item name="colorOnPrimary">@color/denim_900</item>
        <item name="colorPrimaryContainer">@color/denim_700</item>
        <item name="colorOnPrimaryContainer">@color/denim_50</item>

        <item name="colorSecondary">@color/denim_300</item>
        <item name="colorOnSecondary">@color/denim_900</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
