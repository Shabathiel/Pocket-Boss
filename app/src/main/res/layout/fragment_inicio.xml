<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InicioFragment">

    <!-- Contenido principal de la pantalla de inicio (Saldo, lista, etc.) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre de usuario -->
        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola, Usuario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Saldo Actual -->
        <!-- Totales -->
        <TextView
            android:id="@+id/tvIngresos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresos: Q0"
            android:textSize="16sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos: Q0"
            android:textSize="16sp"
            android:textColor="#C62828"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Balance: Q0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Título de la sección de transacciones recientes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Últimas 10 transacciones"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Listado (RecyclerView para las 10 transacciones) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUltimasTransacciones"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

    </LinearLayout>

    <!-- Botones flotantes (FAB) para agregar transacciones y categorías -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:orientation="vertical">

        <!-- Botón flotante para Nueva Categoría -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAgregarCategoriaFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Agregar Categoría"
            app:fabSize="mini"
            android:src="@android:drawable/ic_menu_add" />

        <!-- Botón flotante principal para Nueva Transacción -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnAgregarTransaccionFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Agregar Transacción"
            android:src="@android:drawable/ic_input_add" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>